{
  "expo": {
    "name": "LadyBarberApp",
    "slug": "LadyBarberApp",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/ladybarber-icon.png",
    "scheme": "ladybarberapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/ladybarber-icon.png"
    },
    "android": {
      "package": "com.ismaordaz45.ladybarberapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1B3654",
        "foregroundImage": "./assets/images/ladybarber-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B3654",
          "image": "./assets/images/ladybarber-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1B3654",
            "image": "./assets/images/ladybarber-icon.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba7134a1-2e96-4951-9234-562bdac4d164"
      }
    },
    "owner": "isma_hdz45"
  }
}
